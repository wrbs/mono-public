+(* [f] is passed along rather than captured so that the loop stays a global
+   closure and [@tail_mod_cons] applies. *)
+let[@tail_mod_cons] rec mapi_loop
+  : type n. int -> (_, n) t -> f:(int -> _ -> _) @ local -> (_, n) t
+  =
+  fun i t ~f ->
+  match t with
+  | [] -> []
+  | hd :: tl -> f i hd :: mapi_loop (i + 1) tl ~f
 ;;
 
+let mapi t ~f = mapi_loop 0 t ~f

opam-version: "2.0"
maintainer: "Jane Street developers"
authors: ["Jane Street Group, LLC"]
homepage: "https://github.com/janestreet/unstring"
bug-reports: "https://github.com/janestreet/unstring/issues"
dev-repo: "git+https://github.com/janestreet/unstring.git"
doc: "https://ocaml.janestreet.com/ocaml-core/latest/doc/unstring/index.html"
license: "MIT"
x-maintenance-intent: ["(latest)"]
build: [
  ["dune" "build" "-p" name "-j" jobs]
]
depends: [
  "ocaml" {>= "5.2.0"}
  "base"
  "core"
  "core_kernel"
  "expect_test_helpers_core"
  "heterogeneous_list"
  "ppx_jane"
  "ppx_quick_test"
  "vec"
  "dune"                     {>= "3.17.0"}
  "ppxlib"                   {>= "0.33.0" & < "0.36.0"}
]
available: arch != "x86_32"
conflicts: [
  "oxcaml-compiler" {< "5.2.0minus39"}
]
synopsis: "Typeful, composable string parsers with explicit ambiguity handling"
description: "
Unstring is a library for building low-effort, typeful, composable string parsers.
Includes a PPX for deriving parsers from format strings and type definitions.
"

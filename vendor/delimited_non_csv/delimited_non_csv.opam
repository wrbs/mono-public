opam-version: "2.0"
maintainer: "Jane Street developers"
authors: ["Jane Street Group, LLC"]
homepage: "https://github.com/janestreet/delimited_non_csv"
bug-reports: "https://github.com/janestreet/delimited_non_csv/issues"
dev-repo: "git+https://github.com/janestreet/delimited_non_csv.git"
doc: "https://ocaml.janestreet.com/ocaml-core/latest/doc/delimited_non_csv/index.html"
license: "MIT"
x-maintenance-intent: ["(latest)"]
build: [
  ["dune" "build" "-p" name "-j" jobs]
]
depends: [
  "ocaml" {>= "5.1.0"}
  "async"
  "core"
  "core_extended"
  "delimited_parsing"
  "ppx_jane"
  "dune"              {>= "3.17.0"}
]
available: arch != "x86_32"
conflicts: [
  "oxcaml-compiler" {< "5.2.0minus39"}
]
synopsis: "Parsing of character-separated (without quoting) and fixed-width values"
description: "
Delimited_non_csv provides parsers for non-CSV-like delimited formats, including
character-separated values without quoting and fixed-width positional records.
"

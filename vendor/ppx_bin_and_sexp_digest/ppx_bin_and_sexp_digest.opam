opam-version: "2.0"
maintainer: "Jane Street developers"
authors: ["Jane Street Group, LLC"]
homepage: "https://github.com/janestreet/ppx_bin_and_sexp_digest"
bug-reports: "https://github.com/janestreet/ppx_bin_and_sexp_digest/issues"
dev-repo: "git+https://github.com/janestreet/ppx_bin_and_sexp_digest.git"
doc: "https://ocaml.janestreet.com/ocaml-core/latest/doc/ppx_bin_and_sexp_digest/index.html"
license: "MIT"
x-maintenance-intent: ["(latest)"]
build: [
  ["dune" "build" "-p" name "-j" jobs]
]
depends: [
  "ocaml" {>= "5.2.0"}
  "base"
  "core"
  "expect_test_helpers_core"
  "ppx_bin_prot"
  "ppx_jane"
  "ppx_sexp_digest"
  "dune"                     {>= "3.17.0"}
  "ppxlib"                   {>= "0.33.0" & < "0.36.0"}
]
available: arch != "x86_32"
conflicts: [
  "oxcaml-compiler" {< "5.2.0minus39"}
]
synopsis: "A ppx extension for hashing the sexp_grammar and bin_prot shape of a type."
description: "
This is meant to be used in-place of `[%bin_digest: t]`. See `ppx_sexp_digest` and
   `ppx_bin_prot` for more details about each ppx.
"

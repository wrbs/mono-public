opam-version: "2.0"
maintainer: "Jane Street developers"
authors: ["Jane Street Group, LLC"]
homepage: "https://github.com/janestreet/portable_mpmc_queue"
bug-reports: "https://github.com/janestreet/portable_mpmc_queue/issues"
dev-repo: "git+https://github.com/janestreet/portable_mpmc_queue.git"
doc: "https://ocaml.janestreet.com/ocaml-core/latest/doc/portable_mpmc_queue/index.html"
license: "MIT"
x-maintenance-intent: ["(latest)"]
build: [
  ["dune" "build" "-p" name "-j" jobs]
]
depends: [
  "ocaml" {>= "5.1.0"}
  "base"
  "portable"
  "ppx_jane"
  "dune"     {>= "3.17.0"}
]
available: arch != "x86_32"
conflicts: [
  "oxcaml-compiler" {< "5.2.0minus39"}
]
synopsis: "Portable MPMC queue for OxCaml"
description: "
Portable lock-free multi-producer multi-consumer queue for OxCaml
"

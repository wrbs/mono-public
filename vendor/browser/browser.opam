opam-version: "2.0"
maintainer: "Jane Street developers"
authors: ["Jane Street Group, LLC"]
homepage: "https://github.com/janestreet/browser"
bug-reports: "https://github.com/janestreet/browser/issues"
dev-repo: "git+https://github.com/janestreet/browser.git"
doc: "https://ocaml.janestreet.com/ocaml-core/latest/doc/browser/index.html"
license: "MIT"
x-maintenance-intent: ["(latest)"]
build: [
  ["dune" "build" "-p" name "-j" jobs]
]
depends: [
  "ocaml" {>= "5.1.0"}
  "sexplib"
  "dune"            {>= "3.17.0"}
  "gen_js_api"      {>= "1.0.8"}
  "js_of_ocaml"     {>= "6.0.0"}
  "js_of_ocaml-ppx" {>= "6.0.0"}
  "ppxlib"          {>= "0.33.0" & < "0.36.0"}
  "promise_jsoo"    {= "0.4.3"}
]
available: arch != "x86_32"
conflicts: [
  "oxcaml-compiler" {< "5.2.0minus39"}
]
synopsis: "A library containing bindings to web APIs"
description: "
Browser contains bindings to web APIs. The bindings are generated from Chromium's WebIDL files
"

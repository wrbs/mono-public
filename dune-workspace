(lang dune 3.17)

(env
 (dev
  (ocamlopt_flags
   (:standard -zero-alloc-check none))
  (js_of_ocaml
   (flags
    (:standard --effects=cps))))
 (release
  (ocamlopt_flags
   (:standard -O3))
  (js_of_ocaml
   (flags
    (:standard --effects=cps)))))

(context default)

(context
 (default
  (name opt)
  (profile release)))
